  "lines": [
    {
      "id": "l01",
      "chapter": "hook",
      "text": "Ты попросил найти отель.",
      "breakAfter": "line"
    },
    {
      "id": "l02",
      "chapter": "hook",
      "text": "А он открыл почту.",
      "breakAfter": "line"
    },
    {
      "id": "l03",
      "chapter": "hook",
      "text": "И достал код.",
      "breakAfter": "line"
    },
    {
      "id": "l04",
      "chapter": "hook",
      "text": "Ты не нажал ни одной кнопки.",
      "breakAfter": "block"
    },
    {
      "id": "l05",
      "chapter": "agent",
      "text": "Это агентный браузер.",
      "breakAfter": "line"
    },
    {
      "id": "l06",
      "chapter": "agent",
      "text": "Обычный браузер показывает.",
      "breakAfter": "line"
    },
    {
      "id": "l07",
      "chapter": "agent",
      "text": "Агентный — действует.",
      "breakAfter": "line"
    },
    {
      "id": "l08",
      "chapter": "agent",
      "text": "Читает, кликает,",
      "breakAfter": "soft"
    },
    {
      "id": "l09",
      "chapter": "agent",
      "text": "заполняет формы и отправляет.",
      "breakAfter": "block"
    },
    {
      "id": "l10",
      "chapter": "session",
      "text": "И вот главное.",
      "breakAfter": "line"
    },
    {
      "id": "l11",
      "chapter": "session",
      "text": "Он работает в твоём окне.",
      "breakAfter": "line"
    },
    {
      "id": "l12",
      "chapter": "session",
      "text": "В твоей сессии.",
      "breakAfter": "line"
    },
    {
      "id": "l13",
      "chapter": "session",
      "text": "Он уже вошёл в почту.",
      "breakAfter": "line"
    },
    {
      "id": "l14",
      "chapter": "session",
      "text": "В облако. В банк.",
      "breakAfter": "line"
    },
    {
      "id": "l15",
      "chapter": "session",
      "text": "Для сайта он не робот.",
      "breakAfter": "line"
    },
    {
      "id": "l16",
      "chapter": "session",
      "text": "Для сайта это ты.",
      "breakAfter": "block"
    },
    {
      "id": "l17",
      "chapter": "invisible",
      "text": "Но кто им командует?",
      "breakAfter": "line"
    },
    {
      "id": "l19",
      "chapter": "invisible",
      "text": "Агент читает страницу целиком.",
      "breakAfter": "line"
    },
    {
      "id": "l20",
      "chapter": "invisible",
      "text": "А внутри — чужая инструкция.",
      "breakAfter": "line"
    },
    {
      "id": "l21",
      "chapter": "invisible",
      "text": "Бледный текст, который не видно.",
      "breakAfter": "line"
    },
    {
      "id": "l22",
      "chapter": "invisible",
      "text": "Или надпись внутри картинки.",
      "breakAfter": "line"
    },
    {
      "id": "l24",
      "chapter": "invisible",
      "text": "А агент читает и выполняет.",
      "breakAfter": "block"
    },
    {
      "id": "l25",
      "chapter": "scope",
      "text": "Это не гипотеза.",
      "breakAfter": "line"
    },
    {
      "id": "l26",
      "chapter": "scope",
      "text": "В марте двадцать шестого",
      "breakAfter": "line"
    },
    {
      "id": "l27",
      "chapter": "scope",
      "text": "Зенити описали класс таких атак.",
      "breakAfter": "line"
    },
    {
      "id": "l28",
      "chapter": "scope",
      "text": "Назвали его плиз-фикс.",
      "breakAfter": "line"
    },
    {
      "id": "l29",
      "chapter": "scope",
      "text": "Пять популярных агентных браузеров.",
      "breakAfter": "line"
    },
    {
      "id": "l30",
      "chapter": "scope",
      "text": "Ноль кликов от человека.",
      "breakAfter": "line"
    },
    {
      "id": "l31",
      "chapter": "scope",
      "text": "Чтение файлов, менеджер паролей,",
      "breakAfter": "line"
    },
    {
      "id": "l32",
      "chapter": "scope",
      "text": "захват аккаунта.",
      "breakAfter": "block"
    },
    {
      "id": "l33",
      "chapter": "guard",
      "text": "Что делать?",
      "breakAfter": "line"
    },
    {
      "id": "l34",
      "chapter": "guard",
      "text": "Первое. Не пускай агента в профиль,",
      "breakAfter": "line"
    },
    {
      "id": "l35",
      "chapter": "guard",
      "text": "где открыты банк и почта.",
      "breakAfter": "line"
    },
    {
      "id": "l36",
      "chapter": "guard",
      "text": "Второе. Действие наружу —",
      "breakAfter": "line"
    },
    {
      "id": "l37",
      "chapter": "guard",
      "text": "письмо, платёж, покупка —",
      "breakAfter": "line"
    },
    {
      "id": "l38",
      "chapter": "guard",
      "text": "только с твоим подтверждением.",
      "breakAfter": "block"
    },
    {
      "id": "l39",
      "chapter": "recap",
      "text": "Запомни три вещи.",
      "breakAfter": "line"
    },
    {
      "id": "l40",
      "chapter": "recap",
      "text": "Агент — не советчик, а твои руки.",
      "breakAfter": "line"
    },
    {
      "id": "l41",
      "chapter": "recap",
      "text": "Страница может им командовать.",
      "breakAfter": "line"
    },
    {
      "id": "l42",
      "chapter": "recap",
      "text": "И работает он под твоим логином.",
      "breakAfter": "block"
    },
    {
      "id": "l43",
      "chapter": "cta",
      "text": "Дал бы агенту доступ к банку?",
      "breakAfter": "line"
    },
    {
      "id": "l44",
      "chapter": "cta",
      "text": "Удобно.",
      "breakAfter": "line"
    },
    {
      "id": "l45",
      "chapter": "cta",
      "text": "Или ни за что.",
      "breakAfter": "line"
    },
    {
      "id": "l46",
      "chapter": "cta",
      "text": "Одно слово в комментарии.",
      "breakAfter": "block"
    },
    {
      "id": "l47",
      "chapter": "cta",
      "text": "Дальше — что видит расширение.",
      "breakAfter": "none"
    }
  ],
