  "lines": [
    {
      "id": "l01",
      "chapter": "hook",
      "text": "Когда сайт предлагает создать пасски,",
      "breakAfter": "line"
    },
    {
      "id": "l02",
      "chapter": "hook",
      "text": "многие думают:",
      "breakAfter": "line"
    },
    {
      "id": "l03",
      "chapter": "hook",
      "text": "«Теперь он будет хранить моё лицо».",
      "framing": "myth",
      "breakAfter": "line"
    },
    {
      "id": "l04",
      "chapter": "hook",
      "text": "Но это не так.",
      "breakAfter": "block"
    },
    {
      "id": "l05",
      "chapter": "faceid",
      "text": "Фейс-ай-ди или отпечаток",
      "breakAfter": "soft"
    },
    {
      "id": "l06",
      "chapter": "faceid",
      "text": "нужны только твоему устройству.",
      "breakAfter": "line"
    },
    {
      "id": "l07",
      "chapter": "faceid",
      "text": "Они разрешают телефону",
      "breakAfter": "soft"
    },
    {
      "id": "l08",
      "chapter": "faceid",
      "text": "использовать секретный ключ.",
      "breakAfter": "line"
    },
    {
      "id": "l09",
      "chapter": "faceid",
      "text": "Само лицо на сайт не отправляется.",
      "breakAfter": "block"
    },
    {
      "id": "l10",
      "chapter": "halves",
      "text": "Представь замок",
      "breakAfter": "soft"
    },
    {
      "id": "l11",
      "chapter": "halves",
      "text": "с двумя разными частями.",
      "breakAfter": "line"
    },
    {
      "id": "l12",
      "chapter": "halves",
      "text": "Одна часть хранится у сайта.",
      "breakAfter": "line"
    },
    {
      "id": "l13",
      "chapter": "halves",
      "text": "Она открытая",
      "breakAfter": "soft"
    },
    {
      "id": "l14",
      "chapter": "halves",
      "text": "и сама по себе почти бесполезна.",
      "breakAfter": "line"
    },
    {
      "id": "l15",
      "chapter": "halves",
      "text": "Вторая часть остаётся",
      "breakAfter": "soft"
    },
    {
      "id": "l16",
      "chapter": "halves",
      "text": "на твоём устройстве.",
      "breakAfter": "block"
    },
    {
      "id": "l17",
      "chapter": "login",
      "text": "Когда ты входишь,",
      "breakAfter": "line"
    },
    {
      "id": "l18",
      "chapter": "login",
      "text": "сайт отправляет телефону",
      "breakAfter": "soft"
    },
    {
      "id": "l19",
      "chapter": "login",
      "text": "одноразовый вопрос.",
      "breakAfter": "line"
    },
    {
      "id": "l20",
      "chapter": "login",
      "text": "Телефон подтверждает ответ",
      "breakAfter": "soft"
    },
    {
      "id": "l21",
      "chapter": "login",
      "text": "секретной частью ключа.",
      "breakAfter": "line"
    },
    {
      "id": "l22",
      "chapter": "login",
      "text": "А сайт проверяет его открытой частью.",
      "breakAfter": "line"
    },
    {
      "id": "l23",
      "chapter": "login",
      "text": "Пароль никуда не отправляется.",
      "breakAfter": "line"
    },
    {
      "id": "l24",
      "chapter": "login",
      "text": "Потому что общего пароля вообще нет.",
      "breakAfter": "block"
    },
    {
      "id": "l25",
      "chapter": "phish",
      "text": "И вот главное.",
      "breakAfter": "line"
    },
    {
      "id": "l26",
      "chapter": "phish",
      "text": "Если мошенник создаст",
      "breakAfter": "soft"
    },
    {
      "id": "l27",
      "chapter": "phish",
      "text": "поддельную копию сайта,",
      "breakAfter": "line"
    },
    {
      "id": "l28",
      "chapter": "phish",
      "text": "пасски настоящего сайта",
      "breakAfter": "soft"
    },
    {
      "id": "l29",
      "chapter": "phish",
      "text": "там не сработает.",
      "breakAfter": "line"
    },
    {
      "id": "l30",
      "chapter": "phish",
      "text": "Ключ привязан к правильному адресу.",
      "breakAfter": "block"
    },
    {
      "id": "l31",
      "chapter": "breach",
      "text": "Даже если базу сервиса украдут,",
      "breakAfter": "line"
    },
    {
      "id": "l32",
      "chapter": "breach",
      "text": "там будет только",
      "breakAfter": "soft"
    },
    {
      "id": "l33",
      "chapter": "breach",
      "text": "открытая часть ключа.",
      "breakAfter": "line"
    },
    {
      "id": "l34",
      "chapter": "breach",
      "text": "Из неё нельзя получить секретную часть.",
      "breakAfter": "block"
    },
    {
      "id": "l35",
      "chapter": "cta",
      "text": "Поэтому пасски лучше защищает",
      "breakAfter": "soft"
    },
    {
      "id": "l36",
      "chapter": "cta",
      "text": "от фишинга и украденных паролей.",
      "breakAfter": "line"
    },
    {
      "id": "l37",
      "chapter": "cta",
      "text": "А фейс-ай-ди остаётся на твоём устройстве.",
      "breakAfter": "block"
    },
    {
      "id": "l38",
      "chapter": "cta",
      "text": "Что тебе привычнее:",
      "breakAfter": "line"
    },
    {
      "id": "l39",
      "chapter": "cta",
      "text": "пароль",
      "breakAfter": "line"
    },
    {
      "id": "l40",
      "chapter": "cta",
      "text": "или вход по лицу?",
      "breakAfter": "line"
    },
    {
      "id": "l41",
      "chapter": "cta",
      "text": "Напиши: ПАРОЛЬ или ЛИЦО.",
      "breakAfter": "block"
    },
    {
      "id": "l42",
      "chapter": "cta",
      "text": "А следующим роликом я объясню,",
      "breakAfter": "line"
    },
    {
      "id": "l43",
      "chapter": "cta",
      "text": "почему код из эс-эм-эс",
      "breakAfter": "soft"
    },
    {
      "id": "l44",
      "chapter": "cta",
      "text": "не всегда спасает аккаунт.",
      "breakAfter": "none"
    }
  ],
