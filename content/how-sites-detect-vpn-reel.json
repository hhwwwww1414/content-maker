  "lines": [
    {
      "id": "l01",
      "chapter": "hook",
      "text": "Когда сайт пишет:",
      "breakAfter": "line"
    },
    {
      "id": "l02",
      "chapter": "hook",
      "text": "«Отключите ви-пи-эн»,",
      "breakAfter": "line"
    },
    {
      "id": "l03",
      "chapter": "hook",
      "text": "кажется, будто он заглянул в твой телефон.",
      "breakAfter": "line"
    },
    {
      "id": "l04",
      "chapter": "hook",
      "text": "Но обычно сайт не знает наверняка,",
      "breakAfter": "soft"
    },
    {
      "id": "l05",
      "chapter": "hook",
      "text": "включён у тебя ви-пи-эн или нет.",
      "breakAfter": "line"
    },
    {
      "id": "l06",
      "chapter": "hook",
      "text": "Он просто собирает следы.",
      "breakAfter": "block"
    },
    {
      "id": "l07",
      "chapter": "ip",
      "text": "Первый след — твой ай-пи.",
      "breakAfter": "line"
    },
    {
      "id": "l08",
      "chapter": "ip",
      "text": "Это как обратный адрес",
      "breakAfter": "soft"
    },
    {
      "id": "l09",
      "chapter": "ip",
      "text": "на интернет-посылке.",
      "breakAfter": "line"
    },
    {
      "id": "l10",
      "chapter": "ip",
      "text": "По нему сайт видит:",
      "breakAfter": "line"
    },
    {
      "id": "l11",
      "chapter": "ip",
      "text": "примерную страну",
      "breakAfter": "line"
    },
    {
      "id": "l12",
      "chapter": "ip",
      "text": "и сеть, из которой пришёл запрос.",
      "breakAfter": "block"
    },
    {
      "id": "l13",
      "chapter": "home",
      "text": "Домашний ай-пи принадлежит",
      "breakAfter": "soft"
    },
    {
      "id": "l14",
      "chapter": "home",
      "text": "обычному интернет-провайдеру.",
      "breakAfter": "line"
    },
    {
      "id": "l15",
      "chapter": "home",
      "text": "А многие ви-пи-эн выходят",
      "breakAfter": "soft"
    },
    {
      "id": "l16",
      "chapter": "home",
      "text": "через серверы дата-центров.",
      "breakAfter": "block"
    },
    {
      "id": "l17",
      "chapter": "shared",
      "text": "Второй след:",
      "breakAfter": "line"
    },
    {
      "id": "l18",
      "chapter": "shared",
      "text": "с одного ай-пи",
      "breakAfter": "soft"
    },
    {
      "id": "l19",
      "chapter": "shared",
      "text": "могут одновременно приходить",
      "breakAfter": "soft"
    },
    {
      "id": "l20",
      "chapter": "shared",
      "text": "сотни пользователей.",
      "breakAfter": "line"
    },
    {
      "id": "l21",
      "chapter": "shared",
      "text": "Для обычной квартиры",
      "breakAfter": "soft"
    },
    {
      "id": "l22",
      "chapter": "shared",
      "text": "это странно.",
      "breakAfter": "block"
    },
    {
      "id": "l23",
      "chapter": "rep",
      "text": "Третий след — репутация адреса.",
      "breakAfter": "line"
    },
    {
      "id": "l24",
      "chapter": "rep",
      "text": "Если с этого ай-пи шёл спам,",
      "breakAfter": "line"
    },
    {
      "id": "l25",
      "chapter": "rep",
      "text": "боты",
      "breakAfter": "line"
    },
    {
      "id": "l26",
      "chapter": "rep",
      "text": "или слишком много запросов,",
      "breakAfter": "line"
    },
    {
      "id": "l27",
      "chapter": "rep",
      "text": "сервис начинает ему меньше доверять.",
      "breakAfter": "block"
    },
    {
      "id": "l28",
      "chapter": "risk",
      "text": "Потом сайт складывает признаки:",
      "breakAfter": "line"
    },
    {
      "id": "l29",
      "chapter": "risk",
      "text": "чей это адрес,",
      "breakAfter": "line"
    },
    {
      "id": "l30",
      "chapter": "risk",
      "text": "из какой страны,",
      "breakAfter": "line"
    },
    {
      "id": "l31",
      "chapter": "risk",
      "text": "сколько людей им пользуются,",
      "breakAfter": "line"
    },
    {
      "id": "l32",
      "chapter": "risk",
      "text": "и похоже ли поведение на человека.",
      "breakAfter": "line"
    },
    {
      "id": "l33",
      "chapter": "risk",
      "text": "Поэтому один ви-пи-эн работает,",
      "breakAfter": "line"
    },
    {
      "id": "l34",
      "chapter": "risk",
      "text": "а другой сразу получает проверку или блокировку.",
      "breakAfter": "block"
    },
    {
      "id": "l35",
      "chapter": "cta",
      "text": "Сайт не видит кнопку ви-пи-эн.",
      "breakAfter": "line"
    },
    {
      "id": "l36",
      "chapter": "cta",
      "text": "Он видит следы, которые оставляет твой маршрут.",
      "breakAfter": "line"
    },
    {
      "id": "l37",
      "chapter": "cta",
      "text": "Поэтому фраза «полностью невидимый ви-пи-эн»",
      "framing": "myth",
      "breakAfter": "soft"
    },
    {
      "id": "l38",
      "chapter": "cta",
      "text": "чаще всего является рекламой.",
      "breakAfter": "line"
    },
    {
      "id": "l39",
      "chapter": "cta",
      "text": "Какой сервис чаще всего",
      "breakAfter": "soft"
    },
    {
      "id": "l40",
      "chapter": "cta",
      "text": "просит отключить ви-пи-эн?",
      "breakAfter": "line"
    },
    {
      "id": "l41",
      "chapter": "cta",
      "text": "Напиши его название.",
      "breakAfter": "line"
    },
    {
      "id": "l42",
      "chapter": "cta",
      "text": "В следующем ролике объясню,",
      "breakAfter": "line"
    },
    {
      "id": "l43",
      "chapter": "cta",
      "text": "почему вход по лицу",
      "breakAfter": "soft"
    },
    {
      "id": "l44",
      "chapter": "cta",
      "text": "может быть безопаснее пароля.",
      "breakAfter": "none"
    }
  ],
