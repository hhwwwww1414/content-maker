      "chapter": "hook",
      "text": "Приложение снова просит обновиться.",
      "breakAfter": "line"
    },
    {
      "id": "l02",
      "chapter": "hook",
      "text": "И так каждый месяц.",
      "breakAfter": "line"
    },
    {
      "id": "l03",
      "chapter": "hook",
      "text": "Его никогда не доделают?",
      "breakAfter": "line"
    },
    {
      "id": "l04",
      "chapter": "hook",
      "text": "Нет. И это нормально.",
      "breakAfter": "block"
    },
    {
      "id": "l05",
      "chapter": "rule",
      "text": "Есть правило 90 на 90.",
      "breakAfter": "line"
    },
    {
      "id": "l06",
      "chapter": "rule",
      "text": "Первые 90% кода —",
      "breakAfter": "line"
    },
    {
      "id": "l07",
      "chapter": "rule",
      "text": "это 90% времени.",
      "breakAfter": "line"
    },
