# ElevenLabs TTS (scripts/eleven/*). Never commit real values.
# Ключи пробуются по порядку: когда у первого кончается квота, берётся следующий.
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_2=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# OpenRouter (scripts/conveyor/*) — идеи и сценарии
OPENROUTER_API_KEY=
# Текст: качество важнее цены
OPENROUTER_MODEL_IDEAS=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_IDEAS_FALLBACK=nvidia/nemotron-3-super-120b-a12b:free
# Структура (главы, грамматики, cue): дёшево и предсказуемо
OPENROUTER_MODEL_STRUCTURE=inclusionai/ling-2.6-flash
OPENROUTER_MODEL_STRUCTURE_FALLBACK=openai/gpt-oss-20b:free

# Editorial voice generation uses the ElevenLabs variables above only when run explicitly.
